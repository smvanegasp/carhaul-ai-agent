# Local secrets for development. Copy to .env (git-ignored) and fill in. On AWS the same names
# live in SSM Parameter Store under /carhaul/ (scripts/set_aws_secrets.py, from stage 4).
# Never paste these values into chat, commits or logs.

# CarHauler247 public quote API (QA key)
CARHAULER_API_KEY_QA=
CARHAULER_BASE_URL=https://carhauler247.com/api/public/v2

# Google Maps Platform: enable the Geocoding API on this key
GOOGLE_MAPS_API_KEY=

# LLM: Groq (openai/gpt-oss-20b)
GROQ_API_KEY=

# Speech-to-text: Deepgram
DEEPGRAM_API_KEY=

# Text-to-speech: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Text-to-speech: Cartesia (one of the voices callers can pick)
CARTESIA_API_KEY=

# LiveKit Cloud project (Settings > Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phone transfer to a licensed representative (stage 9, agent/src/mia/transfer.py).
# scripts/setup_twilio_trunk.py creates the trunk and fills the TWILIO_SIP_* lines; the API key
# is only for that script. TRANSFER_CALLER_ID: a verified caller ID in Twilio, NOT the number
# being called (a phone calling itself goes to voicemail).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SIP_ADDRESS=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TRANSFER_PHONE_NUMBER=
TRANSFER_CALLER_ID=
